/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Info über ToTchar"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "ToTchar Version 1.0",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright © Ralf Rosenberger 2002",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_TOTCHAR_DIALOG DIALOGEX 0, 0, 320, 222
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_ACCEPTFILES | WS_EX_APPWINDOW
CAPTION "ToTchar"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "&Ausführen",IDOK,7,201,50,14
    PUSHBUTTON      "Abbrechen",IDCANCEL,263,201,50,14
    CONTROL         "List1",IDC_LISTFILES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SORTASCENDING | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,7,39,306,144
    PUSHBUTTON      "&Hilfe",IDC_MYHELP,133,201,50,14
    PUSHBUTTON      "&Hinzufügen",IDC_ADDFILE,7,7,50,14
    PUSHBUTTON      "&Ordner",IDC_ADDFOLDER,263,7,50,14
    PUSHBUTTON      "&Einstellungen",IDC_OPTIONS,134,7,50,14
END

IDD_OPTIONS DIALOG 0, 0, 260, 95
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Optionen"
FONT 8, "MS Sans Serif"
BEGIN
